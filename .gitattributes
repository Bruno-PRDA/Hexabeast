# Godot writes LF and the addon ships LF; keep the repo LF so diffs stay about code.
* text=auto eol=lf
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.glb binary

# CAD is binary - never line-ending normalise it. STEP is genuinely text.
*.stl binary
*.SLDPRT binary
*.SLDASM binary
*.SLDDRW binary
*.step text
